#!/usr/bin/env python3
"""ocsync v2 — OpenCode Config Sync via Vulcan PG (over SSH tunnel)"""

import subprocess, sys, os, json, hashlib, argparse, tempfile, base64
from pathlib import Path
from datetime import datetime

OC_DIR = Path.home() / ".config" / "opencode"
HOSTNAME = subprocess.check_output(["hostname"], text=True).strip()

SYNC_ITEMS = [
    "opencode.json",
    "opencode.jsonc",
    ".opencode/opencode.json",
    ".opencode/plugins",
    "skills",
    "package.json",
]

C = {"r":"\033[0;31m","g":"\033[0;32m","y":"\033[1;33m","c":"\033[0;36m","b":"\033[1m","n":"\033[0m"}

def pg(sql, fetch=True):
    """Execute SQL on Vulcan PG via SSH + docker exec, SQL passed via stdin"""
    cmd = ["ssh", "-o", "ConnectTimeout=5", "vulcan",
           "docker exec -i shared-postgres psql -U memory_gw -d memory_gateway -t -A"]
    try:
        r = subprocess.run(cmd, input=sql, capture_output=True, text=True, timeout=15)
        if r.returncode != 0 and r.stderr.strip():
            # Filter out NOTICE
            errs = [l for l in r.stderr.strip().split("\n") if "NOTICE" not in l and l.strip()]
            if errs:
                print(f"{C['r']}DB: {errs[0]}{C['n']}", file=sys.stderr)
        if not fetch:
            return []
        return [l for l in r.stdout.strip().split("\n") if l]
    except subprocess.TimeoutExpired:
        print(f"{C['r']}DB timeout{C['n']}", file=sys.stderr)
        return []

def cksum(content):
    return hashlib.sha256(content.encode()).hexdigest()[:16]

def collect_local():
    files = {}
    for item in SYNC_ITEMS:
        path = OC_DIR / item
        if path.is_file():
            files[item] = path.read_text()
        elif path.is_dir():
            for f in sorted(path.rglob("*")):
                if f.is_file() and "node_modules" not in str(f):
                    rel = str(f.relative_to(OC_DIR))
                    try:
                        files[rel] = f.read_text()
                    except UnicodeDecodeError:
                        pass
    return files

def push():
    files = collect_local()
    if not files:
        print(f"{C['y']}No config files found in {OC_DIR}{C['n']}")
        return

    # Build one big SQL transaction
    sql_parts = ["BEGIN;"]
    pushed = 0
    
    # Get existing checksums in one query
    rows = pg(f"SELECT filepath, checksum FROM ocsync_configs WHERE hostname='{HOSTNAME}';")
    existing = {}
    for row in rows:
        parts = row.split("|")
        if len(parts) == 2:
            existing[parts[0]] = parts[1]

    for filepath, content in files.items():
        cs = cksum(content)
        if existing.get(filepath) == cs:
            continue
        b64 = base64.b64encode(content.encode()).decode()
        # Use dollar quoting to avoid escaping
        sql_parts.append(
            f"INSERT INTO ocsync_configs (hostname, filepath, content, checksum, updated_at) "
            f"VALUES ('{HOSTNAME}', '{filepath}', $b64${b64}$b64$, '{cs}', NOW()) "
            f"ON CONFLICT (hostname, filepath) "
            f"DO UPDATE SET content=$b64${b64}$b64$, checksum='{cs}', updated_at=NOW();"
        )
        pushed += 1
        print(f"  {C['g']}↑{C['n']} {filepath}")
    
    sql_parts.append("COMMIT;")
    
    if pushed == 0:
        print(f"{C['g']}✓ Everything up to date{C['n']}")
        return
    
    pg("\n".join(sql_parts), fetch=False)
    print(f"\n{C['g']}✓ Pushed {pushed} file(s){C['n']}")

def pull(source=None):
    hosts = pg("SELECT DISTINCT hostname FROM ocsync_configs ORDER BY hostname;")
    if not hosts:
        print(f"{C['y']}No configs in DB yet.{C['n']}")
        return
    
    other_hosts = [h for h in hosts if h != HOSTNAME]
    if not source:
        if len(other_hosts) == 1:
            source = other_hosts[0]
            print(f"{C['c']}Auto-selected: {source}{C['n']}")
        elif other_hosts:
            print(f"{C['c']}Available hosts:{C['n']}")
            for i, h in enumerate(other_hosts, 1):
                print(f"  {i}. {h}")
            try:
                choice = input("Pull from? [1] ").strip() or "1"
                source = other_hosts[int(choice) - 1]
            except (ValueError, IndexError):
                print(f"{C['r']}Invalid{C['n']}")
                return
        else:
            print(f"{C['y']}Only your config in DB.{C['n']}")
            return

    rows = pg(f"SELECT filepath, content, checksum, updated_at FROM ocsync_configs WHERE hostname='{source}' ORDER BY filepath;")
    if not rows:
        print(f"{C['r']}No configs for {source}{C['n']}")
        return

    remote_files = {}
    for row in rows:
        parts = row.split("|", 3)
        if len(parts) >= 3:
            fp, b64, cs = parts[0], parts[1], parts[2]
            ts = parts[3] if len(parts) > 3 else ""
            try:
                content = base64.b64decode(b64).decode()
                remote_files[fp] = {"content": content, "checksum": cs, "ts": ts}
            except Exception:
                pass

    local_files = collect_local()
    changes = []
    for fp, info in remote_files.items():
        lc = local_files.get(fp)
        if lc is None:
            changes.append(("new", fp, info))
        elif cksum(lc) != info["checksum"]:
            changes.append(("mod", fp, info))

    if not changes:
        print(f"{C['g']}✓ In sync with {source}{C['n']}")
        return

    print(f"\n{C['c']}Changes from {source} → {HOSTNAME}:{C['n']}\n")
    for kind, fp, info in changes:
        if kind == "new":
            print(f"  {C['g']}+ NEW{C['n']}  {fp}")
        else:
            print(f"  {C['y']}~ MOD{C['n']}  {fp}")
            local_path = OC_DIR / fp
            if local_path.exists() and fp.endswith((".json", ".jsonc", ".js")):
                try:
                    with tempfile.NamedTemporaryFile(mode="w", suffix=os.path.splitext(fp)[1], delete=False) as tf:
                        tf.write(info["content"])
                        tf.flush()
                        diff = subprocess.run(["diff", "--color=always", "-u", str(local_path), tf.name],
                                              capture_output=True, text=True)
                        for line in diff.stdout.split("\n")[:20]:
                            print(f"    {line}")
                    os.unlink(tf.name)
                except Exception:
                    pass

    print()
    answer = input(f"Apply {len(changes)} change(s)? [y/N] ").strip().lower()
    if answer != "y":
        print(f"{C['y']}Cancelled{C['n']}")
        return

    for _, fp, info in changes:
        target = OC_DIR / fp
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(info["content"])
        print(f"  {C['g']}✓{C['n']} {fp}")

    print(f"\n{C['g']}✓ Synced {len(changes)} file(s) from {source}{C['n']}")

def diff_cmd(source=None):
    local_files = collect_local()
    hosts = pg("SELECT DISTINCT hostname FROM ocsync_configs ORDER BY hostname;")
    targets = [source] if source else [h for h in hosts if h != HOSTNAME]

    for host in targets:
        rows = pg(f"SELECT filepath, content, checksum FROM ocsync_configs WHERE hostname='{host}' ORDER BY filepath;")
        print(f"\n{C['c']}═══ {HOSTNAME} vs {host} ═══{C['n']}")
        diffs = 0
        remote_fps = set()
        for row in rows:
            parts = row.split("|", 2)
            if len(parts) >= 3:
                fp, b64, cs = parts[0], parts[1], parts[2]
                remote_fps.add(fp)
                lc = local_files.get(fp)
                if lc and cksum(lc) != cs:
                    print(f"  {C['y']}~{C['n']} {fp}")
                    diffs += 1
                elif not lc:
                    print(f"  {C['r']}-{C['n']} {fp} (only on {host})")
                    diffs += 1
        for fp in local_files:
            if fp not in remote_fps:
                print(f"  {C['g']}+{C['n']} {fp} (only on {HOSTNAME})")
                diffs += 1
        if not diffs:
            print(f"  {C['g']}✓ In sync{C['n']}")

def status():
    print(f"{C['c']}ocsync v2{C['n']} — Vulcan PG backend")
    print(f"  Host:       {C['b']}{HOSTNAME}{C['n']}")
    print(f"  Config dir: {OC_DIR}")
    print()
    rows = pg("SELECT hostname, COUNT(*), MAX(updated_at)::text FROM ocsync_configs GROUP BY hostname ORDER BY hostname;")
    if rows:
        print(f"{C['g']}✓ DB connected{C['n']}")
        for row in rows:
            parts = row.split("|")
            if len(parts) >= 3:
                h, cnt, ts = parts[0], parts[1], parts[2]
                you = f" {C['c']}← you{C['n']}" if h == HOSTNAME else ""
                print(f"  {C['b']}{h}{C['n']}: {cnt} files, last sync {ts}{you}")
    else:
        print(f"{C['y']}DB empty or unreachable{C['n']}")

def main():
    p = argparse.ArgumentParser(prog="ocsync", description="OpenCode Config Sync via Vulcan PG")
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("push", help="Push local config to DB")
    pp = sub.add_parser("pull", help="Pull config from another host")
    pp.add_argument("host", nargs="?")
    dp = sub.add_parser("diff", help="Show differences")
    dp.add_argument("host", nargs="?")
    sub.add_parser("status", help="Sync status")
    args = p.parse_args()
    cmds = {"push": push, "pull": lambda: pull(getattr(args,"host",None)),
            "diff": lambda: diff_cmd(getattr(args,"host",None)), "status": status}
    if args.cmd in cmds:
        cmds[args.cmd]() if args.cmd == "push" or args.cmd == "status" else cmds[args.cmd]()
    else:
        p.print_help()

if __name__ == "__main__":
    main()
