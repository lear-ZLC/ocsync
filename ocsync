#!/usr/bin/env python3
"""ocsync v3 — secure OpenCode / OMO configuration synchronisation.

Configuration snapshots live in Vulcan PostgreSQL. Credentials are never stored
as plaintext: each recipient machine has its own RSA key and receives an
OAEP-encrypted envelope. The dashboard exposes metadata only.
"""

import argparse
import base64
import hashlib
import html
import json
import os
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

OC_DIR = Path.home() / ".config" / "opencode"
DATA_DIR = Path.home() / ".local" / "share" / "opencode"
STATE_DIR = Path.home() / ".config" / "ocsync"
PRIVATE_KEY = STATE_DIR / "identity.pem"
PUBLIC_KEY = STATE_DIR / "identity.pub.pem"
HOSTNAME = subprocess.check_output(["hostname"], text=True).strip()
AUTH_PATH = DATA_DIR / "auth.json"
AUTH_ARTIFACT = "__auth__/auth.json"

# Add only product-owned configuration. Backups and node_modules are deliberately excluded.
PROFILES = {
    "core": ["opencode.json", "opencode.jsonc", ".opencode/opencode.json", "dcp.jsonc", "package.json"],
    "omo": ["oh-my-openagent.json", "oh-my-openagent.json.migrations.json"],
    "plugins": [".opencode/plugins", "plugins"],
    "agents": ["agents"],
    "skills": ["skills"],
    "commands": ["command", "commands"],
    "ui": ["tui.json"],
}
DEFAULT_PROFILES = tuple(PROFILES)
C = {"r":"\033[0;31m", "g":"\033[0;32m", "y":"\033[1;33m", "c":"\033[0;36m", "b":"\033[1m", "n":"\033[0m"}


def now():
    return datetime.now(timezone.utc).isoformat()


def cksum(content):
    return hashlib.sha256(content.encode("utf-8")).hexdigest()


def sql_quote(value):
    return "'" + value.replace("'", "''") + "'"


def pg(sql, fetch=True):
    """Run SQL on Vulcan. SQL is passed by stdin, never command interpolation."""
    cmd = ["ssh", "-o", "ConnectTimeout=5", "vulcan", "docker exec -i shared-postgres psql -v ON_ERROR_STOP=1 -U memory_gw -d memory_gateway -t -A"]
    try:
        result = subprocess.run(cmd, input=sql, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        raise RuntimeError("Vulcan PostgreSQL connection timed out")
    if result.returncode:
        message = " ".join(line for line in result.stderr.splitlines() if "NOTICE" not in line).strip()
        raise RuntimeError(message or "PostgreSQL command failed")
    return [line for line in result.stdout.splitlines() if line] if fetch else []


def ensure_schema():
    pg("""
    CREATE TABLE IF NOT EXISTS ocsync_hosts (
      hostname TEXT PRIMARY KEY,
      public_key TEXT NOT NULL,
      key_fingerprint TEXT NOT NULL,
      updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    );
    CREATE TABLE IF NOT EXISTS ocsync_secret_envelopes (
      source_hostname TEXT NOT NULL,
      filepath TEXT NOT NULL,
      recipient_hostname TEXT NOT NULL,
      ciphertext TEXT NOT NULL,
      checksum TEXT NOT NULL,
      updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
      PRIMARY KEY (source_hostname, filepath, recipient_hostname)
    );
    CREATE TABLE IF NOT EXISTS ocsync_jobs (
      id BIGSERIAL PRIMARY KEY,
      source_hostname TEXT NOT NULL,
      target_hostname TEXT NOT NULL,
      profiles TEXT NOT NULL,
      include_auth BOOLEAN NOT NULL DEFAULT FALSE,
      status TEXT NOT NULL DEFAULT 'queued',
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
      completed_at TIMESTAMPTZ,
      result TEXT
    );
    """, fetch=False)


def ensure_identity():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if not PRIVATE_KEY.exists() or not PUBLIC_KEY.exists():
        if not shutil.which("openssl"):
            raise RuntimeError("openssl is required for encrypted credential sync")
        subprocess.run(["openssl", "genpkey", "-algorithm", "RSA", "-pkeyopt", "rsa_keygen_bits:3072", "-out", str(PRIVATE_KEY)], check=True, capture_output=True)
        os.chmod(PRIVATE_KEY, 0o600)
        subprocess.run(["openssl", "pkey", "-in", str(PRIVATE_KEY), "-pubout", "-out", str(PUBLIC_KEY)], check=True, capture_output=True)
    public_key = PUBLIC_KEY.read_text(encoding="utf-8")
    fingerprint = hashlib.sha256(public_key.encode()).hexdigest()[:16]
    pg(
        "INSERT INTO ocsync_hosts (hostname, public_key, key_fingerprint, updated_at) VALUES "
        f"({sql_quote(HOSTNAME)}, {sql_quote(public_key)}, {sql_quote(fingerprint)}, NOW()) "
        "ON CONFLICT (hostname) DO UPDATE SET public_key=EXCLUDED.public_key, key_fingerprint=EXCLUDED.key_fingerprint, updated_at=NOW();",
        fetch=False,
    )
    return fingerprint


def profile_names(raw):
    if not raw:
        return DEFAULT_PROFILES
    names = tuple(name.strip() for name in raw.split(",") if name.strip())
    unknown = [name for name in names if name not in PROFILES]
    if unknown:
        raise ValueError("Unknown profiles: " + ", ".join(unknown))
    return names


def is_safe_relative(path):
    candidate = Path(path)
    return not candidate.is_absolute() and ".." not in candidate.parts


def collect_local(profiles):
    files = {}
    for profile in profiles:
        for item in PROFILES[profile]:
            path = OC_DIR / item
            if path.is_file():
                try:
                    files[item] = (profile, path.read_text(encoding="utf-8"))
                except UnicodeDecodeError:
                    print(f"{C['y']}Skipping non-text config: {item}{C['n']}", file=sys.stderr)
            elif path.is_dir():
                for file_path in sorted(path.rglob("*")):
                    if not file_path.is_file() or "node_modules" in file_path.parts:
                        continue
                    rel = str(file_path.relative_to(OC_DIR))
                    try:
                        files[rel] = (profile, file_path.read_text(encoding="utf-8"))
                    except UnicodeDecodeError:
                        print(f"{C['y']}Skipping non-text config: {rel}{C['n']}", file=sys.stderr)
    return files


def rows_for_host(host):
    return pg(
        "SELECT filepath, content, checksum, updated_at FROM ocsync_configs WHERE hostname="
        f"{sql_quote(host)} ORDER BY filepath;"
    )


def parse_rows(rows):
    result = {}
    for row in rows:
        parts = row.split("|", 3)
        if len(parts) < 3:
            continue
        try:
            result[parts[0]] = {"content": base64.b64decode(parts[1]).decode("utf-8"), "checksum": parts[2], "updated_at": parts[3] if len(parts) > 3 else ""}
        except Exception:
            continue
    return result


def upsert_config(host, filepath, content):
    encoded = base64.b64encode(content.encode("utf-8")).decode("ascii")
    checksum = cksum(content)
    pg(
        "INSERT INTO ocsync_configs (hostname, filepath, content, checksum, updated_at) VALUES "
        f"({sql_quote(host)}, {sql_quote(filepath)}, {sql_quote(encoded)}, {sql_quote(checksum)}, NOW()) "
        "ON CONFLICT (hostname, filepath) DO UPDATE SET content=EXCLUDED.content, checksum=EXCLUDED.checksum, updated_at=NOW();",
        fetch=False,
    )


def init_cmd(_args):
    ensure_schema()
    fingerprint = ensure_identity()
    print(f"{C['g']}✓ Registered {HOSTNAME} ({fingerprint}){C['n']}")
    print(f"  Config root: {OC_DIR}")
    print(f"  Credential key: {PRIVATE_KEY}")


def push_auth(recipients):
    if not AUTH_PATH.is_file():
        print(f"{C['y']}No auth file at {AUTH_PATH}; skipping credentials.{C['n']}")
        return 0
    # Content intentionally remains local except inside recipient-specific OAEP envelopes.
    secret = AUTH_PATH.read_bytes()
    checksum = hashlib.sha256(secret).hexdigest()
    host_rows = pg("SELECT hostname, public_key FROM ocsync_hosts ORDER BY hostname;")
    keys = {}
    for row in host_rows:
        host, public_key = row.split("|", 1)
        keys[host] = public_key
    if recipients:
        wanted = set(recipients.split(","))
        keys = {host: key for host, key in keys.items() if host in wanted}
    if not keys:
        raise RuntimeError("No registered recipient key. Run `ocsync init` on destination machines first.")
    for recipient, public_key in keys.items():
        with tempfile.TemporaryDirectory() as directory:
            pub = Path(directory) / "recipient.pub.pem"
            pub.write_text(public_key, encoding="utf-8")
            encrypted = subprocess.run(
                ["openssl", "pkeyutl", "-encrypt", "-pubin", "-inkey", str(pub), "-pkeyopt", "rsa_padding_mode:oaep", "-pkeyopt", "rsa_oaep_md:sha256"],
                input=secret, capture_output=True, check=True,
            ).stdout
        payload = base64.b64encode(encrypted).decode("ascii")
        pg(
            "INSERT INTO ocsync_secret_envelopes (source_hostname, filepath, recipient_hostname, ciphertext, checksum, updated_at) VALUES "
            f"({sql_quote(HOSTNAME)}, {sql_quote(AUTH_ARTIFACT)}, {sql_quote(recipient)}, {sql_quote(payload)}, {sql_quote(checksum)}, NOW()) "
            "ON CONFLICT (source_hostname, filepath, recipient_hostname) DO UPDATE SET ciphertext=EXCLUDED.ciphertext, checksum=EXCLUDED.checksum, updated_at=NOW();",
            fetch=False,
        )
    print(f"  {C['g']}↑ encrypted auth.json for {len(keys)} recipient(s){C['n']}")
    return len(keys)


def push(args):
    ensure_schema()
    profiles = profile_names(args.profiles)
    files = collect_local(profiles)
    if not files:
        print(f"{C['y']}No selected config files found in {OC_DIR}{C['n']}")
        return
    existing = parse_rows(rows_for_host(HOSTNAME))
    changed = 0
    for filepath, (_profile, content) in files.items():
        if existing.get(filepath, {}).get("checksum") == cksum(content):
            continue
        upsert_config(HOSTNAME, filepath, content)
        changed += 1
        print(f"  {C['g']}↑{C['n']} {filepath}")
    if args.include_auth:
        ensure_identity()
        push_auth(args.auth_recipients)
    print(f"\n{C['g']}✓ Pushed {changed} config file(s) from profiles: {', '.join(profiles)}{C['n']}")


def decrypt_auth(source):
    rows = pg(
        "SELECT ciphertext, checksum FROM ocsync_secret_envelopes WHERE source_hostname="
        f"{sql_quote(source)} AND filepath={sql_quote(AUTH_ARTIFACT)} AND recipient_hostname={sql_quote(HOSTNAME)};"
    )
    if not rows:
        raise RuntimeError(f"No credential envelope from {source} for this machine. Source must run push --include-auth after this host runs init.")
    ciphertext, expected = rows[0].split("|", 1)
    plain = subprocess.run(
        ["openssl", "pkeyutl", "-decrypt", "-inkey", str(PRIVATE_KEY), "-pkeyopt", "rsa_padding_mode:oaep", "-pkeyopt", "rsa_oaep_md:sha256"],
        input=base64.b64decode(ciphertext), capture_output=True, check=True,
    ).stdout
    if hashlib.sha256(plain).hexdigest() != expected:
        raise RuntimeError("Credential checksum verification failed")
    return plain


def pull(args, assume_yes=False):
    ensure_schema()
    source = args.host
    if not source:
        rows = pg("SELECT DISTINCT hostname FROM ocsync_configs ORDER BY hostname;")
        choices = [row for row in rows if row != HOSTNAME]
        if len(choices) != 1:
            raise RuntimeError("Specify source host: ocsync pull <host>")
        source = choices[0]
    profiles = profile_names(args.profiles)
    local = collect_local(profiles)
    remote = parse_rows(rows_for_host(source))
    allowed_roots = {item for profile in profiles for item in PROFILES[profile]}
    selected = {}
    for filepath, info in remote.items():
        if not is_safe_relative(filepath):
            continue
        if any(filepath == root or filepath.startswith(root + "/") for root in allowed_roots):
            selected[filepath] = info
    changes = [(fp, info) for fp, info in selected.items() if fp not in local or cksum(local[fp][1]) != info["checksum"]]
    if not changes and not args.include_auth:
        print(f"{C['g']}✓ In sync with {source} for: {', '.join(profiles)}{C['n']}")
        return
    print(f"\n{C['c']}Changes from {source} → {HOSTNAME}:{C['n']}")
    for filepath, info in changes:
        print(f"  {'~ MOD' if filepath in local else '+ NEW'}  {filepath}")
    if args.include_auth:
        print("  ~ AUTH auth.json (encrypted envelope; value is never displayed)")
    if not assume_yes and not args.yes:
        answer = input(f"Apply {len(changes)} config change(s){' and credentials' if args.include_auth else ''}? [y/N] ").strip().lower()
        if answer != "y":
            print(f"{C['y']}Cancelled{C['n']}")
            return
    for filepath, info in changes:
        target = OC_DIR / filepath
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(info["content"], encoding="utf-8")
        print(f"  {C['g']}✓{C['n']} {filepath}")
    if args.include_auth:
        ensure_identity()
        plaintext = decrypt_auth(source)
        AUTH_PATH.parent.mkdir(parents=True, exist_ok=True)
        AUTH_PATH.write_bytes(plaintext)
        os.chmod(AUTH_PATH, 0o600)
        print(f"  {C['g']}✓{C['n']} auth.json (decrypted locally, mode 0600)")
    print(f"\n{C['g']}✓ Synced from {source}{C['n']}")


def diff_cmd(args):
    profiles = profile_names(args.profiles)
    local = collect_local(profiles)
    sources = [args.host] if args.host else [host for host in pg("SELECT DISTINCT hostname FROM ocsync_configs ORDER BY hostname;") if host != HOSTNAME]
    for source in sources:
        remote = parse_rows(rows_for_host(source))
        print(f"\n{C['c']}═══ {HOSTNAME} vs {source} ═══{C['n']}")
        differences = 0
        for filepath, info in remote.items():
            if filepath not in local:
                print(f"  {C['r']}-{C['n']} {filepath} (only on {source})"); differences += 1
            elif cksum(local[filepath][1]) != info["checksum"]:
                print(f"  {C['y']}~{C['n']} {filepath}"); differences += 1
        for filepath in local:
            if filepath not in remote:
                print(f"  {C['g']}+{C['n']} {filepath} (only on {HOSTNAME})"); differences += 1
        if not differences:
            print(f"  {C['g']}✓ In sync{C['n']}")


def status(_args):
    ensure_schema()
    print(f"{C['c']}ocsync v3{C['n']} — secure config + credential metadata")
    rows = pg("SELECT h.hostname, COUNT(c.filepath), MAX(c.updated_at)::text, h.key_fingerprint FROM ocsync_hosts h LEFT JOIN ocsync_configs c ON c.hostname=h.hostname GROUP BY h.hostname, h.key_fingerprint ORDER BY h.hostname;")
    for row in rows:
        host, count, updated, fingerprint = row.split("|", 3)
        print(f"  {host}: {count} config files, key {fingerprint}, last {updated or 'never'}")


def queue_job(source, target, profiles, include_auth):
    pg(
        "INSERT INTO ocsync_jobs (source_hostname, target_hostname, profiles, include_auth) VALUES "
        f"({sql_quote(source)}, {sql_quote(target)}, {sql_quote(profiles)}, {'TRUE' if include_auth else 'FALSE'});",
        fetch=False,
    )


def agent(args):
    ensure_schema()
    # Supports legacy profile jobs and ConfigHub-selected-file jobs.
    pg("ALTER TABLE ocsync_jobs ADD COLUMN IF NOT EXISTS filepaths TEXT;", fetch=False)
    rows = pg("SELECT id, source_hostname, profiles, include_auth, COALESCE(filepaths,'') FROM ocsync_jobs WHERE target_hostname=" + sql_quote(HOSTNAME) + " AND status='queued' ORDER BY id;")
    if not rows:
        print("No queued sync jobs for this host.")
        return
    for row in rows:
        job_id, source, profiles, include_auth, filepaths = row.split("|", 4)
        pg(f"UPDATE ocsync_jobs SET status='running' WHERE id={int(job_id)};", fetch=False)
        try:
            if filepaths:
                remote = parse_rows(rows_for_host(source))
                selected = [path for path in filepaths.split(",") if is_safe_relative(path)]
                if not selected:
                    raise RuntimeError("No safe selected file paths in job")
                for filepath in selected:
                    info = remote.get(filepath)
                    if not info:
                        raise RuntimeError(f"Source file missing: {filepath}")
                    target = OC_DIR / filepath
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_text(info["content"], encoding="utf-8")
                    print(f"  {C['g']}✓{C['n']} {filepath}")
                result = f"applied {len(selected)} selected file(s) locally"
            else:
                pull(argparse.Namespace(host=source, profiles=profiles, include_auth=include_auth == "t", yes=True), assume_yes=True)
                result = "applied profiles locally"
            pg(f"UPDATE ocsync_jobs SET status='completed', completed_at=NOW(), result={sql_quote(result)} WHERE id={int(job_id)};", fetch=False)
        except Exception as error:
            pg(f"UPDATE ocsync_jobs SET status='failed', completed_at=NOW(), result={sql_quote(str(error)[:1000])} WHERE id={int(job_id)};", fetch=False)
            print(f"{C['r']}Job {job_id} failed: {error}{C['n']}", file=sys.stderr)


def dashboard_data():
    ensure_schema()
    hosts = []
    for row in pg("SELECT h.hostname, h.key_fingerprint, h.updated_at::text, COUNT(c.filepath), MAX(c.updated_at)::text FROM ocsync_hosts h LEFT JOIN ocsync_configs c ON c.hostname=h.hostname GROUP BY h.hostname, h.key_fingerprint, h.updated_at ORDER BY h.hostname;"):
        name, fingerprint, registered, count, synced = row.split("|", 4)
        hosts.append({"name": name, "fingerprint": fingerprint, "registered": registered, "count": count, "synced": synced})
    jobs = []
    for row in pg("SELECT id, source_hostname, target_hostname, profiles, include_auth, status, created_at::text, COALESCE(result,'') FROM ocsync_jobs ORDER BY id DESC LIMIT 30;"):
        parts = row.split("|", 7)
        jobs.append(parts)
    return hosts, jobs


class DashboardHandler(BaseHTTPRequestHandler):
    def log_message(self, _format, *_args):
        return

    def send_html(self, body, code=200):
        encoded = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)

    def do_GET(self):
        if urlparse(self.path).path != "/":
            self.send_html("Not found", 404); return
        hosts, jobs = dashboard_data()
        host_rows = "".join(f"<tr><td>{html.escape(h['name'])}</td><td>{html.escape(h['count'])}</td><td><code>{html.escape(h['fingerprint'])}</code></td><td>{html.escape(h['synced'] or 'never')}</td></tr>" for h in hosts)
        job_rows = "".join(f"<tr><td>{html.escape(j[0])}</td><td>{html.escape(j[1])} → {html.escape(j[2])}</td><td>{html.escape(j[3])}</td><td>{'yes' if j[4] == 't' else 'no'}</td><td>{html.escape(j[5])}</td><td>{html.escape(j[7])}</td></tr>" for j in jobs)
        options = "".join(f'<option value="{html.escape(h["name"])}">{html.escape(h["name"])} ({html.escape(h["count"])} files)</option>' for h in hosts)
        self.send_html(f"""<!doctype html><html lang='tr'><meta charset='utf-8'><title>ocsync</title><style>body{{font:15px system-ui;max-width:1100px;margin:40px auto;padding:0 20px;background:#101317;color:#e6edf3}}section{{background:#171b21;padding:22px;border-radius:12px;margin:18px 0}}table{{width:100%;border-collapse:collapse}}th,td{{text-align:left;padding:9px;border-bottom:1px solid #2a3038}}input,select,button{{padding:9px;margin:4px;background:#222831;color:#e6edf3;border:1px solid #3b4450;border-radius:6px}}button{{background:#2563eb;border:0;cursor:pointer}}small{{color:#9aa4b2}}code{{color:#93c5fd}}</style><h1>ocsync <small>v3 secure dashboard</small></h1><p>Config içerikleri yerine yalnız metadata görünür. Auth hiçbir zaman bu ekranda görüntülenmez; hedef makinenin local agent’ı şifreli paketi çözer.</p><section><h2>Makinalar</h2><table><tr><th>Host</th><th>Config</th><th>Key fingerprint</th><th>Son sync</th></tr>{host_rows}</table></section><section><h2>Sync kuyruğu oluştur</h2><form method='post' action='/queue'><label>Kaynak <select name='source'>{options}</select></label><label>Hedef <select name='target'>{options}</select></label><label>Profiller <input name='profiles' value='core,omo,plugins,agents,skills,commands,ui' size='45'></label><label><input type='checkbox' name='include_auth'> Şifreli auth paketi dahil</label><button>Hedefe kuyrukla</button></form><p><small>Hedef hostta `ocsync agent` çalıştırıldığında iş uygulanır. UI hiçbir hosta doğrudan dosya yazmaz.</small></p></section><section><h2>Son işler</h2><table><tr><th>ID</th><th>Akış</th><th>Profil</th><th>Auth</th><th>Durum</th><th>Sonuç</th></tr>{job_rows}</table></section></html>""")

    def do_POST(self):
        if urlparse(self.path).path != "/queue":
            self.send_html("Not found", 404); return
        size = int(self.headers.get("Content-Length", "0"))
        form = parse_qs(self.rfile.read(size).decode("utf-8"))
        source, target = form.get("source", [""])[0], form.get("target", [""])[0]
        profiles = form.get("profiles", [""])[0]
        try:
            profile_names(profiles)
            if not source or not target or source == target:
                raise ValueError("Source and target must be different registered hosts")
            queue_job(source, target, profiles, "include_auth" in form)
            self.send_response(303); self.send_header("Location", "/"); self.end_headers()
        except Exception as error:
            self.send_html("<h1>Invalid job</h1><p>" + html.escape(str(error)) + "</p><p><a href='/'>Back</a></p>", 400)


def serve(args):
    """Launch the ConfigHub dashboard implementation beside this script."""
    dashboard = Path(__file__).with_name("dashboard.py")
    if not dashboard.is_file():
        raise RuntimeError("dashboard.py is missing beside ocsync")
    subprocess.run([sys.executable, str(dashboard), "--host", args.host, "--port", str(args.port)], check=True)


def main():
    parser = argparse.ArgumentParser(prog="ocsync", description="Secure OpenCode / OMO sync")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("init", help="create local encryption identity and register host")
    for name, help_text in [("push", "push selected local configuration"), ("pull", "pull selected configuration from host"), ("diff", "compare selected profiles with host")]:
        command = sub.add_parser(name, help=help_text)
        if name != "push": command.add_argument("host", nargs="?")
        command.add_argument("--profiles", default=",".join(DEFAULT_PROFILES), help="comma-separated: " + ", ".join(PROFILES))
        if name in ("push", "pull"):
            command.add_argument("--include-auth", action="store_true", help="include encrypted auth.json envelope")
        if name == "push": command.add_argument("--auth-recipients", help="comma-separated registered recipient hosts; default all")
        if name == "pull": command.add_argument("--yes", action="store_true", help="apply without prompt")
    sub.add_parser("status", help="show hosts and encrypted-key metadata")
    sub.add_parser("agent", help="apply queued jobs for this host; run locally on target")
    web = sub.add_parser("serve", help="start local dashboard")
    web.add_argument("--host", default="127.0.0.1")
    web.add_argument("--port", type=int, default=8787)
    args = parser.parse_args()
    try:
        {"init": init_cmd, "push": push, "pull": pull, "diff": diff_cmd, "status": status, "agent": agent, "serve": serve}[args.command](args)
    except (RuntimeError, ValueError, subprocess.CalledProcessError) as error:
        print(f"{C['r']}Error: {error}{C['n']}", file=sys.stderr)
        raise SystemExit(1)


if __name__ == "__main__":
    main()
